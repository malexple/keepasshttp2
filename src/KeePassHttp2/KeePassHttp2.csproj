<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project must have ZERO PackageReference entries and ZERO native
    DLL dependencies. That is the entire point of vendoring Chaos.NaCl as
    source instead of using a NuGet package or the old Zig P/Invoke layer:
    the built plugin has to be a single self-contained managed DLL, so it
    can eventually ship as one .plgx with no companion files and no
    KeePass.exe.config edits.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Reproducible builds, without pulling in the DotNet.ReproducibleBuilds
    NuGet package (that would violate the zero-PackageReference rule
    above - these three properties are plain MSBuild/Roslyn switches, no
    package needed):

      - Deterministic: same inputs -> byte-identical IL/metadata. On by
        default in SDK-style projects, set explicitly so it's not
        silently relying on a default that could change.
      - ContinuousIntegrationBuild: strips the local machine's absolute
        source file paths from the PDB/embedded debug info, replacing
        them with the PathMap below. Without this, two people building
        the same commit from different folder paths get byte-different
        DLLs even though the code is identical.
      - PathMap: normalizes this machine's absolute repo path to a fixed
        token, so the mapping is the same regardless of where anyone
        clones the repo.

    To verify a build matches a published release: build with the exact
    same .NET SDK version (see global.json) from a clean clone, then
    compare `Get-FileHash bin\Release\net48\KeePassHttp2.dll` (PowerShell)
    or `sha256sum` (Linux/WSL) against the SHA256SUMS published with the
    release.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/keepasshttp2/src/KeePassHttp2</PathMap>
  </PropertyGroup>

  <!--
    Required by KeePass, not optional (see keepass.info/help/v2_dev/plg_index.html,
    "Plugin Conventions"): KeePass scans the Plugins folder and uses each
    DLL's file version info Product field to decide whether it's even a
    candidate plugin. If this isn't exactly "KeePass Plugin", KeePass
    silently skips the file - no error, it just never shows up in
    Tools > Plugins. This must stay exactly this string.
  -->
  <PropertyGroup>
    <Product>KeePass Plugin</Product>
  </PropertyGroup>

  <!--
    KeePass.exe is not a NuGet package - it ships with the KeePass
    installation itself, and at runtime the real one must be picked up
    from KeePass's own folder (hence Private=false: don't copy it into
    our output directory). Only needed at compile time to resolve the
    KeePass.Plugins / KeePassLib types.

    Note: this build of KeePass has no separate KeePassLib.dll - KeePassLib
    is merged into KeePass.exe itself, so one reference covers both
    namespaces.

    Override KeePassDir if your install lives elsewhere:
      dotnet build -p:KeePassDir="C:\Path\To\Your\KeePass"
  -->
  <PropertyGroup>
    <KeePassDir Condition="'$(KeePassDir)' == ''">d:\program\TC UP\MEDIA\Programs\KeePass</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassDir)\KeePass.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>